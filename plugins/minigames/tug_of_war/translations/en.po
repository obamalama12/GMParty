msgid "MINIGAME_NAME"
msgstr "Tug of War"

msgid "MINIGAME_DESCRIPTION"
msgstr "Two teams pull a rope: mash the button! Press when the shrinking ring meets the target ring for a much stronger PERFECT pull.\n\nDrag the other team over the line to win the round. Win two rounds to win the match. A tie goes to sudden death!"

msgid "MINIGAME_ACTION_JUMP"
msgstr "Jump"

msgid "MINIGAME_ACTION_PULL"
msgstr "Pull (press as fast as you can)"
