msgid "MINIGAME_NAME"
msgstr "Tug of War"

msgid "MINIGAME_DESCRIPTION"
msgstr "Two teams pull on a rope. Mash the button as fast as you can!\n\nThe team that drags the other one over the line wins. In the 1 vs 3 version the single player pulls as hard as two players."

msgid "MINIGAME_ACTION_JUMP"
msgstr "Jump"

msgid "MINIGAME_ACTION_PULL"
msgstr "Pull (press as fast as you can)"
