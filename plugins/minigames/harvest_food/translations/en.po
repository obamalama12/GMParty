msgid "MINIGAME_NAME"
msgstr "Harvest Food"

msgid "MINIGAME_DESCRIPTION"
msgstr "Pumpkins grow on the field. Carry them to your area to score. Bigger pumpkins and golden ones score more, and you can steal from your rivals!\n\nA golden rush starts halfway and fever time doubles all points at the end."

msgid "MINIGAME_ACTION_PICKUP"
msgstr "Pickup or throw pumpkin"

msgid "HARVEST_GOLDEN_RUSH"
msgstr "Golden rush!"

msgid "HARVEST_FEVER"
msgstr "Fever time! Double points!"

msgid "HARVEST_STOLEN"
msgstr "Stolen!"
