msgid "MINIGAME_NAME"
msgstr "Jump Rope"

msgid "MINIGAME_DESCRIPTION"
msgstr "A rope sweeps around the pole in the middle, faster and faster. Jump over it!\n\nWatch out: the rope turns around now and then, and more ropes join in. The last player who is not hit wins."

msgid "MINIGAME_ACTION_JUMP"
msgstr "Jump"

msgid "MINIGAME_ACTION_PULL"
msgstr "Pull (press as fast as you can)"
