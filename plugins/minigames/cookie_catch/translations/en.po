msgid "MINIGAME_NAME"
msgstr "Cookie Catch"

msgid "MINIGAME_DESCRIPTION"
msgstr "Cookies rain from the sky: catch as many as you can! Golden ones count triple, bombs stun you and cost two cookies.\n\nCatch cookies in a row for a combo, grab stars (speed), magnets and shields, and steal a cookie by bumping a slower rival. A cookie storm hits at the end. Most cookies after 60 seconds wins!"

msgid "MINIGAME_ACTION_JUMP"
msgstr "Jump"

msgid "MINIGAME_ACTION_PULL"
msgstr "Pull (press as fast as you can)"
