msgid "MINIGAME_NAME"
msgstr "Hot Bomb"

msgid "MINIGAME_DESCRIPTION"
msgstr "One player holds a lit bomb. Touch another player to pass it on!\n\nWhen the fuse is burnt up, the player with the bomb is out. The last one standing wins."

msgid "MINIGAME_ACTION_JUMP"
msgstr "Jump"

msgid "MINIGAME_ACTION_PULL"
msgstr "Pull (press as fast as you can)"
